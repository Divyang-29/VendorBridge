# ==============================================================================
# VendorBridge Enterprise Procurement — Environment Configuration Template
# ==============================================================================

# Server Network Configuration
PORT=5055

# Database Connection (MongoDB Atlas or Local replica set)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/vendorbridge?retryWrites=true&w=majority

# JSON Web Token Secret Key (Use a cryptographically secure random string in production)
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars

# Cross-Origin Resource Sharing (Comma-separated list of allowed frontend origins, trailing slashes automatically stripped)
CORS_ORIGIN=http://localhost:5173,https://vendorbridge.example.com

# External Compliance Certificate Storage Directory (Optional: defaults to Backend/uploads/compliance)
COMPLIANCE_UPLOAD_DIR=/var/data/vendorbridge/compliance

# NodeMailer & SMTP Configuration for Procurement Alerts and Status Dispatches
EMAIL_USER=procurement-notifications@example.com
EMAIL_PASS=your_smtp_app_password_or_token
